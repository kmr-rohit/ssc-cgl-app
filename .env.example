# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Frontend (safe to expose; also add both in Vercel → Settings → Environment Variables)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tooling only (secret; local machine only, never in Vercel or the frontend)
# Personal access token scoped to this project, for migrations via the Supabase CLI.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=<project-ref>
